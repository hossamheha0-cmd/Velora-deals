# ===== Velora Deals UAE — Backend Environment Variables =====
# انسخ هذا الملف إلى .env وعدّل القيم الحقيقية قبل التشغيل. لا يتم رفع .env أبدًا لأي Git repo عام.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database (PostgreSQL) ----
# الخيار 1: DATABASE_URL جاهز (مثال: Neon، أو أي مزود PostgreSQL سحابي آخر) - لو موجود، يُستخدم
# مباشرة مع SSL مفعّل تلقائيًا ويتجاهل المتغيرات المنفصلة أدناه.
# مثال Neon: postgresql://user:password@ep-xxxx.neon.tech/velora_deals_uae?sslmode=require
DATABASE_URL=

# الخيار 2: متغيرات منفصلة (للتطوير المحلي) - تُستخدم فقط لو DATABASE_URL فارغ
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=velora_dev_pw
DB_NAME=velora_deals_uae
DB_SYNCHRONIZE=false

# ---- JWT Auth ----
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ---- OTP / SMS Provider ----
# SMS_PROVIDER: "console" (dev, logs OTP instead of sending) | "unifonic" | "twilio"
SMS_PROVIDER=console
# EMAIL_PROVIDER: "console" (dev, logs OTP instead of sending) | "sendgrid" | "ses"
EMAIL_PROVIDER=console
OTP_EXPIRES_IN_SECONDS=300
OTP_LENGTH=6

# ---- Social Login ----
# Google Cloud Console -> OAuth Client ID (Web أو حسب نوع تطبيقك) - بدونه /auth/google يرفض الطلب
GOOGLE_CLIENT_ID=
# Apple Developer -> Service ID / Bundle ID - بدونه /auth/apple يرفض الطلب
APPLE_CLIENT_ID=

# ---- Store Defaults (seeded into settings table, editable from Admin afterwards) ----
DEFAULT_CURRENCY=AED
DEFAULT_SHIPPING_FEE=9
DEFAULT_VAT_RATE=5
DEFAULT_COD_ORDER_STATUS=pending

# ---- AWS (used in production only; leave blank locally) ----
AWS_REGION=me-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

