# Velora Deals UAE — Mobile App Environment Template
#
# انسخ هذا الملف إلى .env في نفس المجلد، ثم عدّل القيم حسب بيئتك.
# ملف .env نفسه مُستثنى من Git (.gitignore) ولا يجب رفعه أبدًا لأي مكان عام.
# هذا الملف (.env.example) لا يحتوي على أي قيمة حقيقية أو سرّية — أسماء المتغيرات فقط.

# ---- رابط الـBackend API الأساسي ----
# محلي (محاكي Android):     http://10.0.2.2:3000/api/v1
# محلي (iOS Simulator):      http://localhost:3000/api/v1
# محلي (جهاز حقيقي):        http://<IP-جهازك-على-نفس-الشبكة>:3000/api/v1
# إنتاج (بعد نشر Backend):  https://<رابط-الـBackend-الفعلي>/api/v1
API_BASE_URL=

# ---- بيئة التشغيل ----
# development أو production
ENVIRONMENT=
